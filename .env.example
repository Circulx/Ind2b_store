# Copy this file to .env.local (development) or set these in your host (production). Never commit real values.

# ---- Database (REQUIRED) ---------------------------------------------------
# Local MongoDB:  mongodb://127.0.0.1:27017/ind2b
# Atlas:          mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ind2b?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ind2b
# Optional: database name. Default = the name in MONGODB_URI, else "ind2b".
# MONGODB_DB=ind2b

# ---- Sessions (REQUIRED in production, 32+ random characters) -------------
SESSION_SECRET=
# While rotating the key: put the old SESSION_SECRET here for one session lifetime.
# SESSION_SECRET_PREVIOUS=

# ---- Super admin (created on start-up) -------------------------------------
# 12+ characters with upper and lower case, a digit and a symbol.
# SUPERADMIN_EMAIL=owner@yourcompany.in
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=Your Name
# SUPERADMIN_RESET_PASSWORD=true      # one-off: overwrite the password of an existing account, then remove

# ---- Demo data -------------------------------------------------------------
# Demo stores and accounts are added to an EMPTY database only. Default: true in development, false in production.
SEED_DEMO_DATA=true
# SHOW_DEMO_ACCOUNTS=true             # show demo logins on sign-in pages in production (not recommended)

# ---- Email (sign-up codes, password reset) ---------------------------------
# gmail | smtp | console (console prints codes in the server log; development only)
EMAIL_PROVIDER=console
# EMAIL_USER=
# EMAIL_APP_PASSWORD=
# EMAIL_FROM_NAME=IND2B
# SMTP_HOST=
# SMTP_PORT=587

# ---- Images (optional; without it images are stored in MongoDB GridFS) -----
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ---- Hosts -----------------------------------------------------------------
# ROOT_DOMAIN=ind2b.com
# APP_URL=https://ind2b.com
# APP_HOSTS=
# TRUST_PROXY=true

# ---- Docker compose only ---------------------------------------------------
# MONGO_ROOT_PASSWORD=
# MONGO_APP_PASSWORD=                 # letters and digits only
